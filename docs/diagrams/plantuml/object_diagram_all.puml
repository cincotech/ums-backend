  drift
  last_t
}

object "EmailDevice" as EmailDevice {
  id
  user
  name
  confirmed
  token
  valid_until
  last_generated_timestamp
  throttling_failure_timestamp
  throttling_failure_count
  created_at
  last_used_at
  email
}

object "OutstandingToken" as OutstandingToken {
  blacklistedtoken
  id
  user
  jti
  token
  created_at
  expires_at
}

object "BlacklistedToken" as BlacklistedToken {
  id
  token
  blacklisted_at
}

@enduml
