<parameter name="content">from django.contrib import admin

from services.core_service.academic_module.teacher_app.models import Attribution


@admin.register(Attribution)
class AttributionAdmin(admin.ModelAdmin):
    """
    Admin configuration for Attribution model with validation fields.
    This model is used to track teacher attributions and their validations by academic administrators.
    """

    list_display = [
        "id",
        "get_course",
        "get_principal_teacher",
        "get_substitute_teacher",
        "academic_year",
        "validation_status",
        "get_validated_by",
        "validation_date",
    ]
    list_filter = [
        "validation_status",
        "validation_date",
        "academic_year",
        "status_principal_teacher",
        "status_substitute_teacher",
    ]
    search_fields = [
        "course__course_name",
        "course__course_code",
        "principal_teacher__user__email",
        "principal_teacher__user__first_name",
        "principal_teacher__user__last_name",
        "substitute_teacher__user__email",
        "substitute_teacher__user__first_name",
        "substitute_teacher__user__last_name",
        "validated_by__email",
        "validated_by__first_name",
        "validated_by__last_name",
        "validation_comments",
    ]
    readonly_fields = [
        "id",
        "validation_date",
    ]
    ordering = ["-date_attribution", "-id"]

    def get_course(self, obj):
        """Get the course name."""
        return f"{obj.course.course_name} ({obj.course.course_code})"

    get_course.short_description = "Course"
    get_course.admin_order_field = "course__course_name"

    def get_principal_teacher(self, obj):
        """Get the principal teacher name."""
        if obj.principal_teacher and obj.principal_teacher.user:
            return f"{obj.principal_teacher.user.first_name} {obj.principal_teacher.user.last_name}"
        return None

    get_principal_teacher.short_description = "Principal Teacher"
    get_principal_teacher.admin_order_field = "principal_teacher__user__last_name"

    def get_substitute_teacher(self, obj):
        """Get the substitute teacher name."""
        if obj.substitute_teacher and obj.substitute_teacher.user:
            return f"{obj.substitute_teacher.user.first_name} {obj.substitute_teacher.user.last_name}"
        return None

    get_substitute_teacher.short_description = "Substitute Teacher"
    get_substitute_teacher.admin_order_field = "substitute_teacher__user__last_name"

    def get_validated_by(self, obj):
        """Get the name of the user who validated."""
        if obj.validated_by:
            return f"{obj.validated_by.first_name} {obj.validated_by.last_name}"
        return None

    get_validated_by.short_description = "Validated By"
    get_validated_by.admin_order_field = "validated_by__last_name"

    fieldsets = (
        (
            "Attribution Information",
            {
                "fields": (
                    "id",
                    "course",
                    "principal_teacher",
                    "substitute_teacher",
                    "academic_year",
                    "date_attribution",
                )
            },
        ),
        (
            "Status Information",
            {
                "fields": (
                    "status_principal_teacher",
                    "status_substitute_teacher",
                    "commentaire",
                    "submitted_by",
                    "authorized_by",
                )
            },
        ),
        (
            "Validation Information",
            {
                "fields": (
                    "validation_status",
                    "validated_by",
                    "validation_date",
                    "validation_comments",
                )
            },
        ),
    )
