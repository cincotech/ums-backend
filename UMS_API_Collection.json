{
  "info": {
    "name": "UMS - University Management System API",
    "description": "Collection complète des APIs du système de gestion universitaire avec authentification JWT et 2FA",
    "version": "1.2.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_email",
      "value": "test@example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "📊 Dashboard Academic Data",
      "item": [
        {
          "name": "Attribution Data",
          "item": [
            {
              "name": "List All Attributions",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic-data/attributions/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic-data", "attributions", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Get Attribution by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic-data/attributions/<uuid>/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic-data", "attributions", "<uuid>", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Create Attribution",
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {
                  "mode": "raw",
                  "raw": "{\"teacher_id\": \"<uuid>\", \"module_id\": \"<uuid>\", \"semester_id\": \"<uuid>\"}"
                },
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic-data/attributions/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic-data", "attributions", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Module Data",
          "item": [
            {
              "name": "List All Modules",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic-data/modules/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic-data", "modules", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Get Module by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic-data/modules/<uuid>/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic-data", "modules", "<uuid>", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Semester Data",
          "item": [
            {
              "name": "List All Semesters",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic-data/semesters/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic-data", "semesters", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Get Semester by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic-data/semesters/<uuid>/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic-data", "semesters", "<uuid>", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "👨🏫 Academic Dashboard",
      "item": [
        {
          "name": "Attribution Validations",
          "item": [
            {
              "name": "List Attribution Validations",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic/attribution-validations/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic", "attribution-validations", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Get Attribution Validation",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic/attribution-validations/<uuid>/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic", "attribution-validations", "<uuid>", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Approve Attribution",
              "request": {
                "method": "PATCH",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {
                  "mode": "raw",
                  "raw": "{\"validation_status\": \"approved\", \"comments\": \"Approuvé\"}"
                },
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic/attribution-validations/<uuid>/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic", "attribution-validations", "<uuid>", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Reject Attribution",
              "request": {
                "method": "PATCH",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {
                  "mode": "raw",
                  "raw": "{\"validation_status\": \"rejected\", \"comments\": \"Rejeté - Raison\"}"
                },
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic/attribution-validations/<uuid>/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic", "attribution-validations", "<uuid>", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Filter by Status",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic/attribution-validations/?validation_status=pending",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic", "attribution-validations", ""],
                  "query": [{"key": "validation_status", "value": "pending"}]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Academic Overview",
          "item": [
            {
              "name": "Get Academic Dashboard",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic/overview/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic", "overview", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            },
            {
              "name": "Get Pending Validations Count",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/dashboard/academic/stats/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "dashboard", "academic", "stats", ""]
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
                }
              },
              "response": []
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["console.log('Exécution de la requête:', pm.info.requestName);"]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Status code is not 500', function () {",
          "    pm.expect(pm.response.code).to.not.equal(500);",
          "});",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ]
}
